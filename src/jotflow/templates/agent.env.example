# agent.env: the drafting and question agent's own environment (D6). Copy this
# file to agent.env next to docker-compose.yml, set it to mode 0600, and fill
# it in. It never holds Slack tokens or the write GitHub token, and JotFlow's
# .env never reaches this container. Execution runs use agent-exec.env.

# This runner's own secret. JotFlow's .env holds the same value as
# JOTFLOW_RUNNER_SECRET; agent-exec.env has a different one. `jotflow init`
# writes both files' secrets and .env's. By hand, generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# JotFlow uses it to start runs; the runner never passes it to the agent.
JOTFLOW_RUNNER_SECRET=

# A fine-grained GitHub token, read-only, limited to the repos your channels
# feed: Issues read-only, and nothing else; GitHub adds Metadata read-only by
# itself. The runner refuses to start if this file also holds a write token.
JOTFLOW_GITHUB_READ_TOKEN=

# The agent preset (#22). It sets the CLI's flags, which tools each run kind
# may use, and the GitHub MCP server's read-only mode. See docs/presets.md.
JOTFLOW_AGENT_PRESET=claude-code
# codex is also available, as experimental, with an API key only. See docs/presets.md.

# The model, optionally. Left out, claude-code uses sonnet for drafting and
# question runs. JOTFLOW_AGENT_MODEL sets both kinds, and the per-kind names
# override it.
#JOTFLOW_AGENT_MODEL=sonnet
#JOTFLOW_AGENT_MODEL_DRAFTING=sonnet
#JOTFLOW_AGENT_MODEL_QUESTION=sonnet

# Only for a CLI without a preset, instead of JOTFLOW_AGENT_PRESET: the command
# as a JSON list. {mcp_config} becomes the run's private MCP config file and
# {run_id} the run id. A custom command's tool limits are your responsibility.
#JOTFLOW_AGENT_COMMAND=["my-agent", "--mcp-config", "{mcp_config}"]

# The model login, passed through to the agent by name. Either an API key here,
# or leave it out and log in once inside this container; the login is kept in
# the agent-home volume.
ANTHROPIC_API_KEY=
JOTFLOW_AGENT_ENV_ALLOW=ANTHROPIC_API_KEY

# syntax=docker/dockerfile:1
#
# The agent container (D6, #54): the team's agent CLI and JotFlow's runner,
# which starts each run when JotFlow asks. It never holds JotFlow's .env, Slack
# tokens, or database; it gets its own agent.env from Compose.
#
# Base images match the JotFlow image's, pinned by tag and digest. The GitHub
# MCP server the presets start (#22) is pinned by release and sha256, one
# checksum per architecture, from the release's checksums file.

ARG TARGETARCH
ARG GITHUB_MCP_VERSION=2.0.2

FROM scratch AS github-mcp-amd64
ARG GITHUB_MCP_VERSION
ADD --checksum=sha256:815e27d931c796af0c97f24fd211e14f8a4607d4528377719a5ad2352086b0b0 \
    https://github.com/github/github-mcp-server/releases/download/v${GITHUB_MCP_VERSION}/github-mcp-server_Linux_x86_64.tar.gz \
    /github-mcp-server.tar.gz

FROM scratch AS github-mcp-arm64
ARG GITHUB_MCP_VERSION
ADD --checksum=sha256:73f5e76c6a3b5e0d731e1134a7c38575df6ec96c646192095a3be2d4d0d6c1fc \
    https://github.com/github/github-mcp-server/releases/download/v${GITHUB_MCP_VERSION}/github-mcp-server_Linux_arm64.tar.gz \
    /github-mcp-server.tar.gz

FROM github-mcp-${TARGETARCH} AS github-mcp

FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM python:3.14-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /src

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --no-install-project

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable

FROM python:3.14-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS runtime

# The agent CLIs install through npm, at the exact versions the presets were
# verified with (docs/presets.md): docker/docker-compose.yml passes both
# "@anthropic-ai/claude-code@2.1.303 @openai/codex@0.163.0", space-separated.
# Empty builds a runner-only image.
ARG AGENT_NPM_PACKAGES=""
ARG AGENT_UID=10002

# npm is needed only to install them. Debian's npm package brings its own old
# copies of node modules, such as Babel 7.20, which scanners flag, so it is
# purged once the install is done. nodejs stays: the CLIs run on it.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends nodejs npm ca-certificates \
    && if [ -n "${AGENT_NPM_PACKAGES}" ]; then \
         npm install --global --no-fund --no-audit ${AGENT_NPM_PACKAGES} \
         && npm cache clean --force; \
       fi \
    # Copilot's npm package brings a native binary for both glibc and musl; this
    # image is glibc, so the musl one (about 190 MB) goes.
    && rm -rf /usr/local/lib/node_modules/@github/copilot/node_modules/@github/copilot-linuxmusl-* \
    && if [ -e /usr/local/bin/copilot ]; then \
         HOME=/tmp/copilot-check XDG_CACHE_HOME=/tmp/copilot-check \
         COPILOT_HOME=/tmp/copilot-check COPILOT_OFFLINE=true copilot --version \
         && rm -rf /tmp/copilot-check; \
       fi \
    && apt-get purge --yes --auto-remove \
         -o APT::AutoRemove::RecommendsImportant=false \
         -o APT::AutoRemove::SuggestsImportant=false npm \
    && rm -rf /var/lib/apt/lists/* /root/.npm \
    && node --version \
    && ! test -e /usr/bin/npm \
    && ! test -e /usr/share/nodejs/@babel \
    && ! test -e /usr/share/nodejs/http-cache-semantics \
    && ! test -e /usr/share/nodejs/word-wrap

RUN --mount=type=bind,from=github-mcp,source=/github-mcp-server.tar.gz,target=/tmp/github-mcp-server.tar.gz \
    tar -xzf /tmp/github-mcp-server.tar.gz -C /usr/local/bin github-mcp-server \
    && chown root:root /usr/local/bin/github-mcp-server \
    && chmod 0755 /usr/local/bin/github-mcp-server \
    && /usr/local/bin/github-mcp-server --version

RUN groupadd --system --gid "${AGENT_UID}" agent \
    && useradd --system --uid "${AGENT_UID}" --gid agent \
        --home-dir /home/agent --create-home --shell /usr/sbin/nologin agent \
    && chmod 0700 /home/agent

# The pool of per-run uids for JOTFLOW_RUNNER_ISOLATION=uid (#181): each with its
# own group, no home and no shell. Unused unless docker-compose.isolation.yml is on.
RUN for n in $(seq 20001 20064); do \
        groupadd --system --gid "$n" "run$n" \
        && useradd --system --uid "$n" --gid "$n" --no-create-home \
            --home-dir /nonexistent --shell /usr/sbin/nologin "run$n"; \
    done

COPY --from=builder /app/.venv /app/.venv

# JOTFLOW_AGENT_IMAGE marks this image; the runner checks nothing from JotFlow's.
ENV PATH="/app/.venv/bin:${PATH}" \
    JOTFLOW_AGENT_IMAGE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/agent

WORKDIR /home/agent
USER agent:agent

CMD ["jotflow", "runner"]

# syntax=docker/dockerfile:1
#
# The agent container (D6, #54): the team's agent CLI and JotFlow's runner,
# which starts each run when JotFlow asks. It never holds JotFlow's .env, Slack
# tokens, or database; it gets its own agent.env from Compose.
#
# Base images match the JotFlow image's, pinned by tag and digest.

FROM ghcr.io/astral-sh/uv:0.13.1@sha256:4a1f3666816dafadd20ceb71eac9a7d56d7ef30279f7d64048519ab901ada336 AS uv

FROM python:3.14-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /src

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --no-install-project

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable

FROM python:3.14-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS runtime

# The agent CLIs install through npm. Presets (#22) name exact versions, for
# example "@anthropic-ai/claude-code@2.1.0". Empty builds a runner-only image.
ARG AGENT_NPM_PACKAGES=""
ARG AGENT_UID=10002

RUN apt-get update \
    && apt-get install --yes --no-install-recommends nodejs npm ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && if [ -n "${AGENT_NPM_PACKAGES}" ]; then \
         npm install --global --no-fund --no-audit ${AGENT_NPM_PACKAGES} \
         && npm cache clean --force; \
       fi

RUN groupadd --system --gid "${AGENT_UID}" agent \
    && useradd --system --uid "${AGENT_UID}" --gid agent \
        --home-dir /home/agent --create-home --shell /usr/sbin/nologin agent \
    && chmod 0700 /home/agent

COPY --from=builder /app/.venv /app/.venv

# JOTFLOW_AGENT_IMAGE marks this image; the runner checks nothing from JotFlow's.
ENV PATH="/app/.venv/bin:${PATH}" \
    JOTFLOW_AGENT_IMAGE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/agent

WORKDIR /home/agent
USER agent:agent

CMD ["jotflow", "runner"]

# agent.env: the drafting and question agent's own environment (D6). Copy this
# file to agent.env next to docker-compose.yml, set it to mode 0600, and fill
# it in. It never holds Slack tokens or the write GitHub token, and JotFlow's
# .env never reaches this container. Execution runs use agent-exec.env.

# This runner's own secret. JotFlow's .env holds the same value as
# JOTFLOW_RUNNER_SECRET; agent-exec.env has a different one. Generate it with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# JotFlow uses it to start runs; the runner never passes it to the agent.
JOTFLOW_RUNNER_SECRET=

# A fine-grained GitHub token, read-only, limited to the repos your channels
# feed: Contents read, Issues read. The runner refuses to start if this file
# also holds a write token.
JOTFLOW_GITHUB_READ_TOKEN=

# The agent CLI to start for each run, as a JSON list. {mcp_config} becomes the
# run's private MCP config file and {run_id} the run id. Presets (#22) will
# replace this with a name. Example for Claude Code:
#   ["claude", "-p", "Call get_work, then act.", "--mcp-config", "{mcp_config}", "--strict-mcp-config"]
JOTFLOW_AGENT_COMMAND=

# The model login, passed through to the agent by name. Either an API key here,
# or leave it out and log in once inside this container; the login is kept in
# the agent-home volume.
ANTHROPIC_API_KEY=
JOTFLOW_AGENT_ENV_ALLOW=ANTHROPIC_API_KEY

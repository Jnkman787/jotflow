# agent-exec.env: the execution agent's own environment (D6). Copy this file to
# agent-exec.env next to docker-compose.yml, set it to mode 0600, and fill it
# in. This container runs only approved proposals, one at a time. It never
# holds Slack tokens or the read GitHub token, and JotFlow's .env never reaches
# it. Drafting runs, which read Slack text, never run in this container.

# This runner's own secret, different from agent.env's. JotFlow's .env holds it
# as JOTFLOW_RUNNER_EXEC_SECRET. Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# A separate secret means a drafting run that reads agent.env's secret still
# cannot start anything here.
JOTFLOW_RUNNER_SECRET=

# A fine-grained GitHub token that can write issues, limited to the repos your
# channels feed: Issues read and write. The runner refuses to start if this
# file also holds a read token.
JOTFLOW_GITHUB_WRITE_TOKEN=

# The agent preset; see agent.env.example and docs/presets.md.
JOTFLOW_AGENT_PRESET=claude-code

# The model, optionally. Left out, claude-code uses haiku for execution runs,
# which make a single write.
#JOTFLOW_AGENT_MODEL_EXECUTION=haiku

# The model login for this container. Its login, if you log in interactively,
# is kept in its own agent-exec-home volume.
ANTHROPIC_API_KEY=
JOTFLOW_AGENT_ENV_ALLOW=ANTHROPIC_API_KEY
